# Supabase Configuration
# Replace these values in your local .env file. Never commit .env to Git.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional test runner credentials (local development / testing only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# TEST_DEFAULT_PASSWORD=your-test-password-here
# TEST_OWNER_PASSWORD=...
# TEST_MANAGER1_PASSWORD=...
# TEST_DRIVER1_PASSWORD=...
# TEST_PARENT1_PASSWORD=...
# TEST_MANAGER2_PASSWORD=...
